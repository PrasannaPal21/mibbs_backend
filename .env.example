# ------------------------------------------------------------------
# MIBBS Backend env — copy to .env and fill the blanks for local dev.
# Production deploys (Render / Vercel) set these in the dashboard, not here.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=4000
API_PREFIX=v1
# Comma-separated whitelist of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Postgres ----------------------------------------------------------
# Local Docker uses the URL below. Production should point at Neon's
# pooled URL (host contains `-pooler`) for DATABASE_URL and the direct
# (non-pooler) URL for DIRECT_URL (so Prisma migrations don't go
# through pgbouncer). Locally, set both to the same value.
DATABASE_URL=postgresql://mibbs:mibbs@localhost:5432/mibbs?schema=public
DIRECT_URL=postgresql://mibbs:mibbs@localhost:5432/mibbs?schema=public

# Redis -------------------------------------------------------------
# Provide either REDIS_URL (e.g. Upstash rediss://default:xxxx@host:6379)
# OR the host/port/password trio for local Docker Redis. URL wins.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth --------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# Refresh-token cookie attributes ---------------------------------
# COOKIE_SECURE: 'auto' (true in production, false locally), or 'true' / 'false'.
# COOKIE_SAMESITE: 'lax' for same-domain deploys, 'none' for cross-site
#                  (e.g. Vercel frontend ↔ Render backend on different domains).
# COOKIE_DOMAIN: leave blank to scope cookie to the exact host (recommended
#                for cross-site Vercel ↔ Render). Set to .yourdomain.com if you
#                have custom subdomains on the same root.
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Providers (leave blank until creds arrive — adapters fall back to stub)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WHATSAPP_PROVIDER=stub
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=

EMAIL_PROVIDER=stub
RESEND_API_KEY=
EMAIL_FROM=MIBBS <no-reply@mibbs.app>

SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Logging
LOG_LEVEL=info
